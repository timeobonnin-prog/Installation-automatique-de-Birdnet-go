<Window x:Class="BirdNETGoControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BirdNET-Go" Height="560" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#313244" BorderThickness="1">
        <DockPanel>

            <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#313244" CornerRadius="12,12,0,0" Padding="14,8">
                <Grid>
                    <TextBlock Text="BirdNET-Go" Foreground="#CDD6F4" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⚙" Click="OnSettings" Style="{StaticResource TitleButton}"/>
                        <Button Content="─" Click="OnMinimize" Style="{StaticResource TitleButton}"/>
                        <Button Content="✕" Click="OnClose" Style="{StaticResource TitleButton}" Foreground="#F38BA8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="24">

                <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#F38BA8" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtStatus" Text="HORS LIGNE" Foreground="#F38BA8" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnToggle" Content="DÉMARRER LE SERVEUR" Background="#10B981" Click="OnToggle" Style="{StaticResource RoundedButton}" Margin="0,0,0,12"/>
                <Button x:Name="BtnOpen" Content="🌐 Ouvrir l'interface web" Background="#45475A" Foreground="#CDD6F4" Click="OnOpen" IsEnabled="False" Style="{StaticResource RoundedButton}" Margin="0,0,0,20"/>

                <Border Background="#313244" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CONTRÔLEUR" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtUiVersion" Text="v0.0.0" Foreground="#CDD6F4" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MOTEUR" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtEngineVersion" Text="v0.0.0" Foreground="#CDD6F4" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtUpdateStatus" Text="Vérification..." Foreground="#A6ADC8" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Button x:Name="BtnUpdate" Content="METTRE À JOUR" FontSize="13" Background="#8B5CF6" Click="OnUpdate" Style="{StaticResource RoundedButton}"/>
                        <TextBlock Text="Met à jour le contrôleur ET le moteur" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>
