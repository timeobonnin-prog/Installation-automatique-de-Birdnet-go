<Window x:Class="BirdNETGoControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BirdNET-Go" Height="650" Width="850"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#334155">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="12" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Margin="10">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Background="Transparent" Name="TitleBar">
                <TextBlock Text="BirdNET-Go // Control Center" Foreground="#64748B" FontSize="12" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Width="45" Height="35" Background="Transparent" 
                            Foreground="#94A3B8" Click="OnMinimize"/>
                    <Button Content="✕" Width="45" Height="35" Background="Transparent" 
                            Foreground="#94A3B8" Click="OnClose"/>
                </StackPanel>
            </Grid>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Background="#020617" CornerRadius="0,0,0,12">
                    <StackPanel Margin="20,30,20,0">
                        <TextBlock Text="BirdNET-Go" Foreground="#38BDF8" FontSize="22" FontWeight="Bold" Margin="0,0,0,40"/>
                        <TextBlock Text="MENU" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                        <Border Background="#1E293B" CornerRadius="8" Padding="15,10">
                            <TextBlock Text="Dashboard" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <Grid Grid.Column="1" Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Dashboard" Foreground="#F8FAFC" FontSize="32" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Margin="0,30,0,0">
                        <Border Background="#1E293B" CornerRadius="8" Padding="25" Margin="0,0,0,20"
                                BorderThickness="1" BorderBrush="#334155">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#EF4444"
                                         Name="StatusDot" Margin="0,0,15,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ÉTAT DU SYSTÈME" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="HORS LIGNE" Foreground="#EF4444" FontSize="20" 
                                               FontWeight="Bold" Name="TxtStatus"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Name="BtnOpen" Content="OUVRIR L'INTERFACE WEB" Background="#0284C7" Click="OnOpen"/>
                        <Button Name="BtnToggle" Content="DÉMARRER LE SERVEUR" Background="#10B981" Click="OnToggle"/>
                        <Button Name="BtnUpdate" Content="METTRE À JOUR BIRDNET-GO" Background="#8B5CF6" Click="OnUpdate"/>
                        <TextBlock Name="TxtUpdateStatus" Text="Vérification..." 
                                   Foreground="#64748B" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
