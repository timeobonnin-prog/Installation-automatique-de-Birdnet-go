<Window x:Class="BirdNETGoControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BirdNET-Go" Height="480" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    
    <!-- Style réutilisable pour des boutons aux bords arrondis -->
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#313244" BorderThickness="1">
        <DockPanel>
            <!-- Barre de titre -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#313244" CornerRadius="12,12,0,0" Padding="12,8">
                <Grid>
                    <TextBlock Text="BirdNET-Go" Foreground="#CDD6F4" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Width="36" Height="30" Click="OnMinimize" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="#CDD6F4" FontSize="16"/>
                        <Button Content="✕" Width="36" Height="30" Click="OnClose" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="#F38BA8" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenu principal -->
            <StackPanel Margin="24">
                <!-- Indicateur de statut -->
                <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#F38BA8" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtStatus" Text="HORS LIGNE" Foreground="#F38BA8" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Contrôles du serveur -->
                <Button x:Name="BtnToggle" Content="DÉMARRER LE SERVEUR" Background="#10B981" Padding="16" Click="OnToggle" Margin="0,0,0,16" Style="{StaticResource RoundedButton}"/>
                <Button x:Name="BtnOpen" Content="🌐 Ouvrir l'interface web" Background="#45475A" Foreground="#CDD6F4" Padding="16" Click="OnOpen" IsEnabled="False" Margin="0,0,0,24" Style="{StaticResource RoundedButton}"/>

                <!-- Section Mise à jour -->
                <Border Background="#313244" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="TxtUpdateStatus" Text="Vérification des mises à jour..." Foreground="#A6ADC8" HorizontalAlignment="Center" FontSize="13" Margin="0,0,0,12"/>
                        <Button x:Name="BtnUpdate" Content="METTRE À JOUR BIRDNET-GO" Background="#8B5CF6" Padding="16" Click="OnUpdate" Style="{StaticResource RoundedButton}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
