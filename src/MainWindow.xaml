<Window x:Class="BirdNETGoControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BirdNET-Go" Height="640" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#313244" BorderThickness="1">
        <DockPanel>

            <!-- Barre de titre -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#313244" CornerRadius="12,12,0,0" Padding="14,8">
                <Grid>
                    <TextBlock Text="BirdNET-Go" Foreground="#CDD6F4" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⚙" Click="OnSettings" Style="{StaticResource TitleButton}"/>
                        <Button Content="─" Click="OnMinimize" Style="{StaticResource TitleButton}"/>
                        <Button Content="✕" Click="OnClose" Style="{StaticResource TitleButton}" Foreground="#F38BA8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation par onglets -->
            <Border DockPanel.Dock="Top" Background="#26263A" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NavControl" Grid.Column="0" Content="Contrôle" Style="{StaticResource NavButton}" Click="OnNavControl" Margin="0,0,4,0"/>
                    <Button x:Name="NavResults" Grid.Column="1" Content="Résultats" Style="{StaticResource NavButton}" Click="OnNavResults" Margin="2,0,2,0"/>
                    <Button x:Name="NavStats"   Grid.Column="2" Content="Statistiques" Style="{StaticResource NavButton}" Click="OnNavStats" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- Panneaux -->
            <Grid>
                <!-- ===== ONGLET CONTRÔLE ===== -->
                <ScrollViewer x:Name="PanelControl" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#F38BA8" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtStatus" Text="HORS LIGNE" Foreground="#F38BA8" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnToggle" Content="DÉMARRER LE SERVEUR" Background="#10B981" Click="OnToggle" Style="{StaticResource RoundedButton}" Margin="0,0,0,10"/>
                        <Button x:Name="BtnOpen" Content="🌐 Ouvrir l'interface web" Background="#45475A" Foreground="#CDD6F4" Click="OnOpen" IsEnabled="False" Style="{StaticResource RoundedButton}" Margin="0,0,0,16"/>

                        <Border Background="#313244" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtLblController" Text="CONTRÔLEUR" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtUiVersion" Text="v0.0.0" Foreground="#CDD6F4" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="TxtLblEngine" Text="MOTEUR" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEngineVersion" Text="v0.0.0" Foreground="#CDD6F4" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="TxtUpdateStatus" Text="Vérification..." Foreground="#A6ADC8" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Button x:Name="BtnUpdate" Content="METTRE À JOUR" FontSize="13" Background="#8B5CF6" Click="OnUpdate" Style="{StaticResource RoundedButton}"/>
                                <TextBlock x:Name="TxtUpdateHint" Text="Met à jour le contrôleur ET le moteur" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== ONGLET RÉSULTATS ===== -->
                <ScrollViewer x:Name="PanelResults" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Background="#313244" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PulseDot" Width="12" Height="12" Fill="#F38BA8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtListening" Text="—" Foreground="#CDD6F4" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLatency" Text="" Foreground="#6C7086" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#313244" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtToday" Text="—" Foreground="#89B4FA" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtLast" Text="—" Foreground="#A6ADC8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtApiNote" Text="" Foreground="#6C7086" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnRefresh" Content="Rafraîchir" Background="#45475A" Click="OnRefreshStats" Style="{StaticResource RoundedButton}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== ONGLET STATISTIQUES ===== -->
                <ScrollViewer x:Name="PanelStats" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TxtSparkTitle" Text="—" Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#15151F" CornerRadius="10" Height="130" Padding="8" Margin="0,0,0,14">
                            <Polyline x:Name="Spark" Stroke="#A6E3A1" StrokeThickness="2" Stretch="Fill" Points=""/>
                        </Border>

                        <TextBlock x:Name="TxtTopTitle" Text="—" Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtTop" Text="—" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button x:Name="BtnExport" Content="Exporter CSV" Background="#8B5CF6" Click="OnExportCsv" Style="{StaticResource RoundedButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
