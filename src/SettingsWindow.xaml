<Window x:Class="BirdNETGoControl.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réglages" Height="740" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MiniCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#313244" BorderThickness="1">
        <DockPanel>

            <Border DockPanel.Dock="Top" Background="#313244" CornerRadius="12,12,0,0" Padding="14,10" MouseLeftButtonDown="OnDrag">
                <Grid>
                    <TextBlock x:Name="TxtSettingsTitle" Text="⚙️ Réglages du contrôleur" Foreground="#CDD6F4" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="32" Height="28" HorizontalAlignment="Right" Click="OnCancel" Style="{StaticResource TitleButton}" Foreground="#F38BA8"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="16,12" Background="#1A1A28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnCancel" Grid.Column="0" Content="Annuler" Background="#45475A" Margin="0,0,8,0" Click="OnCancel" Style="{StaticResource RoundedButton}"/>
                    <Button x:Name="BtnSave" Grid.Column="1" Content="💾 Enregistrer" Background="#10B981" Margin="8,0,0,0" Click="OnSave" Style="{StaticResource RoundedButton}"/>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="TxtIntro" Text="Options du contrôleur uniquement." Foreground="#6C7086" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- ===== LANGUE ===== -->
                    <Border Background="#232336" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#89B4FA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtGrpLanguage" Text="LANGUE" Style="{StaticResource GroupTitle}"/>
                            <TextBlock x:Name="TxtLblLanguage" Text="Langue de l'interface" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbLanguage" Style="{StaticResource LanguageCombo}" SelectionChanged="OnLanguageChanged"/>
                            <TextBlock x:Name="TxtLangCount" Text="16 langues · BirdNET-Go" Foreground="#6C7086" FontSize="11" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#313244" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtGrpStartup" Text="DÉMARRAGE" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="ChkStartup" Content="Lancer au démarrage de Windows" Style="{StaticResource Check}"/>
                            <CheckBox x:Name="ChkAutoStart" Content="Démarrer le serveur automatiquement" Style="{StaticResource Check}"/>
                            <CheckBox x:Name="ChkMinimize" Content="Minimiser dans le tray" Style="{StaticResource Check}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#313244" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtGrpServer" Text="SERVEUR (birdnet-go.exe)" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="ChkAutoRestart" Content="Relancer après un crash" Style="{StaticResource Check}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtLblAttempts" Text="Tentatives max" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbAttempts" Grid.Column="1" Style="{StaticResource MiniCombo}">
                                    <ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/>
                                    <ComboBoxItem Content="3" Tag="3"/><ComboBoxItem Content="5" Tag="5"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtLblDelay" Text="Délai avant relance" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbDelay" Grid.Column="1" Style="{StaticResource MiniCombo}">
                                    <ComboBoxItem Content="1 s" Tag="1"/><ComboBoxItem Content="2 s" Tag="2"/>
                                    <ComboBoxItem Content="5 s" Tag="5"/><ComboBoxItem Content="10 s" Tag="10"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="ChkStopOnExit" Content="Arrêter le serveur en quittant" Style="{StaticResource Check}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#313244" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtGrpUpdates" Text="MISES À JOUR" Style="{StaticResource GroupTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtLblFreq" Text="Vérification" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbUpdateFreq" Grid.Column="1" Style="{StaticResource MiniCombo}"/>
                            </Grid>
                            <CheckBox x:Name="ChkNightly" Content="Autoriser les Nightly (bêta)" Style="{StaticResource Check}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#313244" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtGrpUi" Text="INTERFACE &amp; MAINTENANCE" Style="{StaticResource GroupTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtLblPort" Text="Port de l'interface web" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtPort" Grid.Column="1" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,5" VerticalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtLblPurge" Text="Purge des logs" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbPurge" Grid.Column="1" Style="{StaticResource MiniCombo}"/>
                            </Grid>
                            <CheckBox x:Name="ChkBalloon" Content="Notifications (bulles tray)" Style="{StaticResource Check}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#292537" CornerRadius="10" Padding="14" BorderBrush="#F9E2AF" BorderThickness="1" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="TxtGrpDetection" Text="🐦 RÉGLAGES DE DÉTECTION" Style="{StaticResource GroupTitle}" Foreground="#F9E2AF"/>
                            <TextBlock x:Name="TxtDetectionHint" Text="Sensibilité, seuil, espèces : dans l'interface web du moteur."
                                       Foreground="#A6ADC8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button x:Name="BtnOpenEngineWeb" Content="🌐 Ouvrir l'interface web du moteur" Background="#45475A" Click="OnOpenWeb" Style="{StaticResource RoundedButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
