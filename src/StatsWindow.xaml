<Window x:Class="BirdNETGoControl.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Résultats" Height="560" Width="460"
        Background="#1E1E2E" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Ellipse x:Name="PulseDot" Width="12" Height="12" Fill="#F38BA8" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtListening" Text="—" Foreground="#CDD6F4" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtLatency" Text="" Foreground="#6C7086" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnRefresh" Content="Rafraîchir" Margin="16,0,0,0" Padding="10,3" Click="OnRefresh"/>
        </StackPanel>

        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem x:Name="TabDash" Header="Tableau de bord" Background="#313244" Foreground="#CDD6F4">
                <StackPanel Margin="6,10">
                    <TextBlock x:Name="TxtToday" Text="—" Foreground="#89B4FA" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtLast" Text="—" Foreground="#A6ADC8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtApiNote" Text="" Foreground="#6C7086" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="TabStats" Header="Statistiques" Background="#313244" Foreground="#CDD6F4">
                <StackPanel Margin="6,10">
                    <TextBlock x:Name="TxtSparkTitle" Text="—" Foreground="#89B4FA" FontWeight="Bold"/>
                    <Border Background="#15151F" CornerRadius="8" Height="120" Margin="0,8,0,12" Padding="6">
                        <Polyline x:Name="Spark" Stroke="#A6E3A1" StrokeThickness="2" Stretch="Fill" Points=""/>
                    </Border>
                    <TextBlock x:Name="TxtTopTitle" Text="—" Foreground="#89B4FA" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTop" Text="—" Foreground="#CDD6F4" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <Button x:Name="BtnExport" Content="Exporter CSV" Padding="10,4" HorizontalAlignment="Left" Click="OnExport"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
